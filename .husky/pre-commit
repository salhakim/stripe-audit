# stripe-audit — pre-commit gate (portable: self-contained, works on a fresh clone
# of the public repo — depends on nothing under .claude/).
# Bypass the secret scan ONLY in a genuine emergency, PER-INVOCATION (never export,
# or you silently disable every later commit in the shell):
#   SKIP_GITLEAKS=1 git commit ...   (justify in the commit body)
# Inline override for an inspected placeholder: append  # gitleaks:allow  to the line.

# 1) Secret scan of staged changes — fail-closed (a missing scanner blocks the commit).
if [ "${SKIP_GITLEAKS:-}" != "1" ]; then
  if command -v gitleaks >/dev/null 2>&1; then
    # Load the project ruleset when present (gitleaks also auto-discovers it at the
    # repo root; the explicit flag keeps this gate identical to gitleaks-guard.sh).
    GL_CONFIG=""
    [ -f .gitleaks.toml ] && GL_CONFIG="--config .gitleaks.toml"
    gitleaks git --staged --redact --no-banner $GL_CONFIG || {
      echo "✖ gitleaks: potential secret in staged changes — commit blocked."
      echo "  Inspected placeholder?  append  # gitleaks:allow  to the line."
      echo "  Verified false positive / emergency?  SKIP_GITLEAKS=1 git commit ..."
      exit 1
    }
  else
    echo "✖ gitleaks not installed (brew install gitleaks) — secret scan required, commit blocked."
    exit 1
  fi
fi

# 2) Type + lint gates (fast; the full test suite runs in CI).
npm run typecheck || exit 1
npm run lint || exit 1

# 3) Text-integrity gate — no raw control bytes in tracked source/docs (a raw NUL
# makes git treat the file as binary and blinds diff/blame/review).
npm run check:bytes || exit 1
